(import base)
(import data)
(import formatter.model)
(import formatter.model :as m)

(base:constant u64-67108864 u64 67108864)
(base:constant u64-1 u64 1)
(base:constant u64-0 u64 0)
(base:constant u64-2 u64 2)

; Byte-oriented output with bounded storage; literal lexemes are never rewritten.
(base:function byte ((out (pointer data:data)) (column (pointer u64)) (value u8)) m:status
  (match (>= (data:length (deref out)) u64-67108864)
    (true (m:limit 0 "formatted output limit (64 MiB) exceeded"))
    (false
      (m:steps
        (m:from-storage (data:append out value))
        (do
          (store (deref column) (match value (10 0) (13 0) (_ (+ (deref column) u64-1))))
          (m:success))))))

(base:function raw
  ((out (pointer data:data)) (column (pointer u64)) (bytes (pointer u8)) (size u64)) m:status
  (match (== size u64-0)
    (true (m:success))
    (false
      (match (== size u64-1)
        (true (byte out column (deref bytes)))
        (false
          (let ((half u64 (/ size u64-2)))
            (m:steps
              (raw out column bytes half)
              (raw out column (pointer-offset bytes half) (- size half)))))))))

(base:function token
  ((source data:view) (node m:node) (out (pointer data:data)) (column (pointer u64))) m:status
  (raw out column (pointer-offset (field source bytes) (field node start)) (field node length)))

(base:function spaces ((out (pointer data:data)) (column (pointer u64)) (count u64)) m:status
  (match (== count u64-0)
    (true (m:success))
    (false
      (match (== count u64-1)
        (true (byte out column 32))
        (false
          (let ((half u64 (/ count u64-2)))
            (m:steps (spaces out column half) (spaces out column (- count half)))))))))

(base:function line ((out (pointer data:data)) (column (pointer u64)) (indent u64)) m:status
  (m:steps
    (match (== (deref column) u64-0) (true (m:success)) (false (byte out column 10)))
    (spaces out column indent)))

(base:function blank ((out (pointer data:data)) (column (pointer u64))) m:status
  (m:steps (line out column 0) (byte out column 10)))

(export byte raw token spaces line blank)
